<?xml version="1.0" encoding="utf-8"?>
<!-- No extra inset: an adaptive icon already reserves the outer 18dp of its
     108dp canvas for masking, and the artwork is drawn to sit inside the 72dp
     mask circle. The previous 16.7% inset shrank the can a second time. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
